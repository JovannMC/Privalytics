{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		// prevent needing to add .js/.ts extensions to imports, after sveltekit v3 moved to subpaths in node
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"#routes": ["./src/routes"],
			"#routes/*": ["./src/routes/*"],
			"#api": ["./src/routes/api"],
			"#api/*": ["./src/routes/api/*"],
			"#root": ["./"],
			"#root/*": ["./*"]
		}
	},
	"include": ["src", "vite.config.ts", "prettier.config.js", "eslint.config.js"]
}
